mod.wizards {
  newContentElement {
    wizardItems {
      plugins {
        show = *
        elements {
          jwfrontendusermanager_listofusers {
            iconIdentifier = extension-jw_feuser_manager-listofusers
            title = LLL:EXT:jw_feuser_manager/Resources/Private/Language/locallang_be.xlf:tt_content.list_type_listofusers
            description = LLL:EXT:jw_feuser_manager/Resources/Private/Language/locallang_be.xlf:tt_content.list_type_listofusers_description
			tt_content_defValues {
              CType = list
			  list_type = jwfrontendusermanager_listofusers
            }
          }
        }
      }
    }
  }
}
mod.wizards {
  newContentElement {
    wizardItems {
