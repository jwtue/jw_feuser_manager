            description = LLL:EXT:jw_feuser_manager/Resources/Private/Language/locallang_be.xlf:tt_content.list_type_edituser_description
			tt_content_defValues {
              CType = list
			  list_type = jwfrontendusermanager_edituser
            }
          }
        }
      }
    }
  }
}
