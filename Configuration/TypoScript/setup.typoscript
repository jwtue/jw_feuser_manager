plugin.tx_jwfeusermanager {
	view {
		templateRootPaths {
			0 = EXT:jw_feuser_manager/Resources/Private/Templates/
			1 = {$plugin.tx_jwfeusermanager.view.templateRootPath}
		}

		partialRootPaths  {
			0 = EXT:jw_feuser_manager/Resources/Private/Partials/
			1 = {$plugin.tx_jwfeusermanager.view.partialRootPath}
		}

		layoutRootPaths  {
			0 = EXT:jw_feuser_manager/Resources/Private/Layouts/
			1 = {$plugin.tx_jwfeusermanager.view.layoutRootPath}
		}
	}
	settings {
		orderBy = lastName,firstName
		fields = last_name,first_name,email
	}
}

page.includeCSS.tx_jwfeusermanager = EXT:jw_feuser_manager/Resources/Public/Css/jw_feuser_manager.css

# Registers the extension's own form element types (ImageCrop, DateTimePicker, ...).
# Without this line EXT:form silently replaces them with empty elements —
# see the comment in the YAML file.
plugin.tx_form.settings.yamlConfigurations.1740000000 = EXT:jw_feuser_manager/Configuration/Yaml/FormSetup.yaml

# Note: tt_content.list.20.jwfeusermanager_{listofusers,edituser} is registered
# automatically as an EXTBASEPLUGIN by ExtensionUtility::configurePlugin().
#
# There used to be a "< lib.contentElement" on both signatures here, which replaced this
# EXTBASEPLUGIN with a FLUIDTEMPLATE without a templateName — the plugins therefore did
# not work (error: "Tried resolving a template file for controller action
# Default->Default"). Also removed: a dataProcessing on jwfeusermanager_edituser that has
# no effect on an EXTBASEPLUGIN. The controller fetches the editor fields itself via the
# EditorFieldRepository anyway.

# ==============================================
# Persistence object mapping configuration
# ==============================================
# The mapping is located in Configuration/Extbase/Persistence/Classes.php.
# The former duplication via config.tx_extbase.persistence.classes has been removed:
# this TypoScript variant has been superseded since TYPO3 v10 and was maintained here in
# parallel, which inevitably drifts apart on changes.