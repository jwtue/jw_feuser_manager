plugin.tx_jwfeusermanager {
	view {
		templateRootPaths {
			0 = EXT:jw_feuser_manager/Resources/Private/Templates/
			1 = {$plugin.tx_jwfeusermanager.view.templateRootPath}
		}

		partialRootPaths  {
			0 = EXT:jw_feuser_manager/Resources/Private/Partials/
			1 = {$plugin.tx_jwfeusermanager.view.partialRootPath}
		}

		layoutRootPaths  {
			0 = EXT:jw_feuser_manager/Resources/Private/Layouts/
			1 = {$plugin.tx_jwfeusermanager.view.layoutRootPath}
		}
	}
	settings {
		orderBy = lastName,firstName
		fields = last_name,first_name,email
	}
}

page.includeCSS.tx_jwfeusermanager = EXT:jw_feuser_manager/Resources/Public/Css/jw_feuser_manager.css

# Hinweis: tt_content.list.20.jwfeusermanager_{listofusers,edituser} wird von
# ExtensionUtility::configurePlugin() automatisch als EXTBASEPLUGIN registriert.
#
# Hier stand zuvor ein "< lib.contentElement" auf beide Signaturen, das dieses
# EXTBASEPLUGIN durch ein FLUIDTEMPLATE ohne templateName ersetzt hat — die Plugins
# liefen dadurch nicht (Fehler: "Tried resolving a template file for controller action
# Default->Default"). Ebenso entfernt: ein dataProcessing auf jwfeusermanager_edituser,
# das bei einem EXTBASEPLUGIN ohne Wirkung ist. Die Editor-Felder holt sich der
# Controller ohnehin selbst über das EditorFieldRepository.

# ==============================================
# Persistence object mapping configuration
# ==============================================
# Das Mapping steht in Configuration/Extbase/Persistence/Classes.php.
# Die frühere Doppelung über config.tx_extbase.persistence.classes ist entfernt:
# Diese TypoScript-Variante ist seit TYPO3 v10 abgelöst und wurde hier parallel
# gepflegt, was bei Änderungen zwangsläufig auseinanderläuft.