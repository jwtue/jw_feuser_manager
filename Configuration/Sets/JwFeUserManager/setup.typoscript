plugin.tx_jwfeusermanager {
	view {
		templateRootPaths {
			0 = EXT:jw_feuser_manager/Resources/Private/Templates/
			1 = {$plugin.tx_jwfeusermanager.view.templateRootPath}
		}

		partialRootPaths  {
			0 = EXT:jw_feuser_manager/Resources/Private/Partials/
			1 = {$plugin.tx_jwfeusermanager.view.partialRootPath}
		}

		layoutRootPaths  {
			0 = EXT:jw_feuser_manager/Resources/Private/Layouts/
			1 = {$plugin.tx_jwfeusermanager.view.layoutRootPath}
		}
	}
	settings {
		orderBy = lastName,firstName
		fields = last_name,first_name,email
	}
}

page.includeCSS.tx_jwfeusermanager = EXT:jw_feuser_manager/Resources/Public/Css/jw_feuser_manager.css

# Frontend rendering of the two plugin CTypes. ExtensionUtility::configurePlugin()
# also generates this into the "default" TypoScript, but declaring it here (loaded
# after fluid_styled_content via the set dependency) guarantees lib.contentElement is
# defined and the CTypes have a rendering definition.
tt_content.jwfeusermanager_listofusers =< lib.contentElement
tt_content.jwfeusermanager_listofusers {
    templateName = Generic
    20 = EXTBASEPLUGIN
    20 {
        extensionName = JwFeUserManager
        pluginName = ListOfUsers
    }
}
tt_content.jwfeusermanager_edituser =< lib.contentElement
tt_content.jwfeusermanager_edituser {
    templateName = Generic
    20 = EXTBASEPLUGIN
    20 {
        extensionName = JwFeUserManager
        pluginName = EditUser
    }
}

# Registers the extension's own form element types (ImageCrop, DateTimePicker, ...).
# Without this line EXT:form silently replaces them with empty elements.
plugin.tx_form.settings.yamlConfigurations.1740000000 = EXT:jw_feuser_manager/Configuration/Yaml/FormSetup.yaml
